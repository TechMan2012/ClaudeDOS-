mkdir -p /root /tmp
rm -f /tmp/busy
printf '%s[?7l' "$ESC"

open_info build_help "Welcome" 56 22
redraw

while :; do
    read_key
    if [ -z "$KEY" ]; then tick; continue; fi
    ACT=""
    if [ "$KEY" = MOUSE ]; then
        case "$MT" in
            d) mouse_down $MC $MR ;;
            g) mouse_drag $MC $MR ;;
            u) DRAGID="" ;;
            x) mouse_dbl $MC $MR ;;
            r) mouse_rclick $MC $MR ;;
            w) mouse_wheel $MC $MR $MD ;;
        esac
    elif [ "$KEY" = FAST ]; then
        game_tick
    elif [ "$KEY" = "$K_CN" ]; then
        open_launcher; MODE=app; ACT=full
    elif [ "$KEY" = "$K_CW" ]; then
        if [ "$MODE" = app ]; then MODE=wm; else MODE=app; ICON_SEL=-1; fi
        ACT=full
    elif [ "$MODE" = wm ]; then
        wm_key
    elif [ "$MODE" = icons ]; then
        icons_key
    elif [ "$KEY" = "$K_CX" ]; then
        [ -n "$FOCUS" ] && { close_win $FOCUS; ACT=full; }
    elif [ "$KEY" = ESC ]; then
        g "${FOCUS:-0}" type T
        if [ "$T" = launch ] || [ "$T" = ctx ]; then close_win $FOCUS; ACT=full; else MODE=wm; ACT=top; fi
    elif [ -n "$FOCUS" ]; then
        app_key
    fi
    case "$ACT" in
        full)    redraw ;;
        content) [ -n "$FOCUS" ] && paint draw_content $FOCUS ;;
        top)     paint draw_topbar ;;
    esac
    fast_sync
done
