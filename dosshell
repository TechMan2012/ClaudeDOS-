#!/bin/sh
# ClaudeDOS Desktop -- a windowed text-mode desktop written in plain sh.
# Every app lives in its own window. Windows overlap, have focus, and can be
# moved, resized, maximized and closed with the keyboard or the mouse.
# Input arrives from /bin/kbmouse as one event per line (see kbmouse.c).

ESC=$(printf '\033')
NL='
'
TAB=$(printf '\t')
K_ENTER=$(printf '\r')
K_BS=$(printf '\177')
K_BS2=$(printf '\010')
K_CS=$(printf '\023')   # Ctrl+S
K_CX=$(printf '\030')   # Ctrl+X
K_CW=$(printf '\027')   # Ctrl+W
K_CN=$(printf '\016')   # Ctrl+N

RST="${ESC}[0m"

# ---------------------------------------------------------------
#  themes and timezones (settings reset on reboot: everything is RAM)
# ---------------------------------------------------------------
THEME_NAMES="teal dosblue amber contrast"
THEME_IDX=0
THEME_LABEL="Teal Desktop"

apply_theme() {
    case "$1" in
        dosblue)
            THEME_LABEL="DOS Blue"
            DESKA="${ESC}[0;34;44m"; BODY="${ESC}[0;30;47m"; TON="${ESC}[0;30;46m"
            TOFF="${ESC}[0;37;40m"; SELA="${ESC}[0;30;46m"; STAT="${ESC}[1;37;44m"
            SHAD="${ESC}[0;30;40m"; BARA="${ESC}[0;30;47m"; TOPA="${ESC}[0;30;46m"
            WMA="${ESC}[1;37;41m"; TERMA="${ESC}[0;37;40m" ;;
        amber)
            THEME_LABEL="Amber Terminal"
            DESKA="${ESC}[0;33;40m"; BODY="${ESC}[0;33;40m"; TON="${ESC}[0;30;43m"
            TOFF="${ESC}[0;33;40m"; SELA="${ESC}[0;30;43m"; STAT="${ESC}[0;30;43m"
            SHAD="${ESC}[0;30;40m"; BARA="${ESC}[0;30;43m"; TOPA="${ESC}[0;30;43m"
            WMA="${ESC}[1;37;41m"; TERMA="${ESC}[0;33;40m" ;;
        contrast)
            THEME_LABEL="High Contrast"
            DESKA="${ESC}[0;37;40m"; BODY="${ESC}[1;37;40m"; TON="${ESC}[0;30;47m"
            TOFF="${ESC}[1;37;40m"; SELA="${ESC}[0;30;47m"; STAT="${ESC}[0;30;47m"
            SHAD="${ESC}[0;30;40m"; BARA="${ESC}[0;30;47m"; TOPA="${ESC}[0;30;47m"
            WMA="${ESC}[1;37;41m"; TERMA="${ESC}[1;37;40m" ;;
        *)
            THEME_LABEL="Teal Desktop"
            DESKA="${ESC}[0;37;46m"; BODY="${ESC}[0;30;47m"; TON="${ESC}[1;37;44m"
            TOFF="${ESC}[0;37;40m"; SELA="${ESC}[1;37;44m"; STAT="${ESC}[0;30;46m"
            SHAD="${ESC}[0;30;40m"; BARA="${ESC}[0;30;47m"; TOPA="${ESC}[1;37;44m"
            WMA="${ESC}[1;37;41m"; TERMA="${ESC}[0;37;40m" ;;
    esac
}

TZ_TABLE="UTC|UTC0${NL}US Eastern|EST5EDT,M3.2.0,M11.1.0${NL}US Central|CST6CDT,M3.2.0,M11.1.0${NL}US Mountain|MST7MDT,M3.2.0,M11.1.0${NL}US Pacific|PST8PDT,M3.2.0,M11.1.0${NL}UK|GMT0BST,M3.5.0/1,M10.5.0${NL}Central Europe|CET-1CEST,M3.5.0,M10.5.0/3${NL}India|IST-5:30${NL}Japan|JST-9${NL}Australia East|AEST-10AEDT,M10.1.0,M4.1.0/3"
TZ_COUNT=10
TZ_IDX=0
TZ_LABEL="UTC"

set_tz() {
    nth_line_basic "$TZ_TABLE" $1
    TZ_LABEL=${NTH%%|*}
    TZ=${NTH#*|}
    export TZ
}

nth_line_basic() { NTH=""; local i=0 l; while IFS= read -r l; do [ $i -eq $2 ] && NTH="$l"; i=$((i+1)); done <<EOF
$1
EOF
}

nth_word() { local n=$1; shift; shift $n 2>/dev/null; NW=$1; }

apply_theme teal
TXA="$BODY"
set_tz 0

DASHES=""
i=0
while [ $i -lt 30 ]; do DASHES="${DASHES}----------"; i=$((i+1)); done

# ---- screen size (falls back to 80x25) ----
set -- $(stty -F /dev/tty size 2>/dev/null)
ROWS=${1:-25}
COLS=${2:-80}
[ "$ROWS" -lt 25 ] 2>/dev/null && ROWS=25
[ "$COLS" -lt 80 ] 2>/dev/null && COLS=80
[ "$COLS" -gt 200 ] && COLS=200

NEXT=1
ORDER=""
FOCUS=""
MODE=app
NOW=""
NEWID=""
ACT=""
ICON_SEL=-1
ET_TOTAL=0; ET_START=0; ET_MAX=0

# ---- window "records": W_<id>_<field> ----
g() { eval "$3=\${W_$1_$2}"; }
s() { eval "W_$1_$2=\$3"; }
geom() { g $1 x X; g $1 y Y; g $1 w W; g $1 h H; }
cgeom() { geom $1; CX=$((X+1)); CY=$((Y+1)); CW=$((W-2)); CH=$((H-2)); }
crow() { printf '\033[%d;%dH%s%-*.*s' $((CY+$1)) $CX "$3" $CW $CW "$2"; }
paint() { "$@" > /tmp/.frame; cat /tmp/.frame; }
busy_on() { : > /tmp/busy; }
busy_off() { rm -f /tmp/busy; }

# ---------------------------------------------------------------
#  text helpers
# ---------------------------------------------------------------
# emit_text <text> <maxrows> <tail 0/1> <cursor 0/1> <scroll>
#   tail=1: show the last rows, <scroll> lines up from the bottom
#   tail=0: show from line <scroll>
emit_text() {
    local t="$1" max=$2 tl=$3 cur=$4 sc=${5:-0} total=0 l i=0 start=0 shown
    while IFS= read -r l; do total=$((total+1)); done <<EOF
$t
EOF
    if [ $total -gt $max ]; then
        if [ "$tl" = 1 ]; then start=$((total-max-sc)); else start=$sc; fi
        [ $start -lt 0 ] && start=0
        [ $start -gt $((total-max)) ] && start=$((total-max))
    fi
    ET_TOTAL=$total; ET_START=$start; ET_MAX=$max
    while IFS= read -r l; do
        if [ $i -ge $start ] && [ $i -lt $((start+max)) ]; then
            if [ "$cur" = 1 ] && [ $i -eq $((total-1)) ]; then l="${l}_"; fi
            crow $((i-start)) "$l" "$TXA"
        fi
        i=$((i+1))
    done <<EOF
$t
EOF
    shown=$((total-start)); [ $shown -gt $max ] && shown=$max
    while [ $shown -lt $max ]; do crow $shown "" "$TXA"; shown=$((shown+1)); done
}

# emit_list <list> <sel> <top> <maxrows> <row0>   (sets LTOP, ET_*)
emit_list() {
    local lst="$1" sel=$2 top=$3 max=$4 row0=$5 i=0 shown=0 l a
    [ $sel -lt $top ] && top=$sel
    [ $sel -ge $((top+max)) ] && top=$((sel-max+1))
    [ $top -lt 0 ] && top=0
    LTOP=$top
    while IFS= read -r l; do
        if [ $i -ge $top ] && [ $i -lt $((top+max)) ]; then
            if [ $i -eq $sel ]; then a="$SELA"; else a="$BODY"; fi
            crow $((i-top+row0)) " $l" "$a"
            shown=$((shown+1))
        fi
        i=$((i+1))
    done <<EOF
$lst
EOF
    ET_TOTAL=$i; ET_START=$top; ET_MAX=$max
    while [ $shown -lt $max ]; do crow $((shown+row0)) "" "$BODY"; shown=$((shown+1)); done
}

# visible scrollbar on the window's right border (only if content overflows)
draw_scroll() {  # row offset of first content row inside window = 1
    local total=$ET_TOTAL start=$ET_START max=$ET_MAX tr r pos
    [ $total -le $max ] && return
    tr=$((H-4))
    printf '\033[%d;%dH%s^' $((Y+1)) $((X+W-1)) "$BODY"
    printf '\033[%d;%dHv' $((Y+H-2)) $((X+W-1))
    [ $tr -lt 1 ] && return
    r=1
    while [ $r -le $tr ]; do printf '\033[%d;%dH:' $((Y+1+r)) $((X+W-1)); r=$((r+1)); done
    pos=$(( start*(tr-1)/(total-max) ))
    printf '\033[%d;%dH#' $((Y+2+pos)) $((X+W-1))
}

count_lines() { CNT=0; local l; while IFS= read -r l; do CNT=$((CNT+1)); done <<EOF
$1
EOF
}

nth_line() { NTH=""; local i=0 l; while IFS= read -r l; do [ $i -eq $2 ] && NTH="$l"; i=$((i+1)); done <<EOF
$1
EOF
}

# ---------------------------------------------------------------
#  window frame
# ---------------------------------------------------------------
draw_window() {
    local id=$1 r TA T
    geom $id
    g $id title T
    if [ "$id" = "$FOCUS" ]; then TA="$TON"; else TA="$TOFF"; fi
    if [ $((X+W)) -le $COLS ] && [ $((Y+H)) -le $((ROWS-1)) ]; then
        r=$((Y+1))
        while [ $r -le $((Y+H)) ]; do
            printf '\033[%d;%dH%s ' $r $((X+W)) "$SHAD"
            r=$((r+1))
        done
        printf '\033[%d;%dH%s%*s' $((Y+H)) $((X+1)) "$SHAD" $W ''
    fi
    printf '\033[%d;%dH%s%-*.*s[=][x]%s' $Y $X "$TA" $((W-6)) $((W-6)) " $T" "$RST"
    r=$((Y+1))
    while [ $r -lt $((Y+H-1)) ]; do
        printf '\033[%d;%dH%s|%*s|' $r $X "$BODY" $((W-2)) ''
        r=$((r+1))
    done
    printf '\033[%d;%dH%s+%.*s+%s' $((Y+H-1)) $X "$BODY" $((W-2)) "$DASHES" "$RST"
}

draw_content() {
    local TYPE
    g $1 type TYPE
    cgeom $1
    TXA="$BODY"
    case "$TYPE" in
        note)     c_note $1 ;;
        files)    c_files $1 ;;
        term)     c_term $1 ;;
        calc)     c_calc $1 ;;
        info)     c_info $1 ;;
        launch)   c_launch $1 ;;
        apps)     c_apps $1 ;;
        settings) c_settings $1 ;;
        ctx)      c_ctx $1 ;;
    esac
    printf '%s' "$RST"
}

draw_topbar() {
    local a m
    case "$MODE" in
        wm)
            a="$WMA"
            m=" WINDOW MODE | Arrows:move +/-:size Tab:next M:max X:close N:start D:icons Esc:back" ;;
        icons)
            a="$WMA"
            m=" DESKTOP ICONS | Up/Down:select  Enter:open  Esc:back" ;;
        *)
            a="$TOPA"
            m=" ClaudeDOS Desktop | Esc:window mode  ^N:start  ^X:close  | mouse works too" ;;
    esac
    printf '\033[1;1H%s%-*.*s%s' "$a" $COLS $COLS "$m" "$RST"
}

ICON_LABELS="My Apps${NL}My Computer${NL}My Files"
draw_icons() {
    local i=0 l r a
    while IFS= read -r l; do
        r=$((3+i*2))
        if [ $i -eq $ICON_SEL ]; then a="$SELA"; else a="$DESKA"; fi
        printf '\033[%d;3H%s%s %-12s%s' $r "$a" "${ESC}[1m" "$l" "$RST"
        i=$((i+1))
    done <<EOF
$ICON_LABELS
EOF
}

draw_clock() {
    printf '\033[%d;%dH%s %s %s' $ROWS $((COLS-6)) "$BARA" "$NOW" "$RST"
}

draw_taskbar() {
    local bar=" Start ^N |" i=1 T e pos=11
    while [ $i -lt $NEXT ]; do
        g $i type T
        if [ -n "$T" ]; then
            g $i title T
            if [ "$i" = "$FOCUS" ]; then e=" <${T%% -*}>"; else e=" [${T%% -*}]"; fi
            s $i tbs $((pos+1)); s $i tbe $((pos+${#e}))
            pos=$((pos+${#e}))
            bar="${bar}${e}"
        fi
        i=$((i+1))
    done
    printf '\033[%d;1H%s%-*.*s%s' $ROWS "$BARA" $COLS $COLS "$bar" "$RST"
    draw_clock
}

do_redraw() {
    local i
    printf '%s%s%s' "${ESC}[?25l" "$DESKA" "${ESC}[2J"
    draw_topbar
    draw_icons
    for i in $ORDER; do draw_window $i; draw_content $i; done
    draw_taskbar
}

# window rectangles for the pointer-shape logic in kbmouse
write_wins() {
    local i
    : > /tmp/wins
    for i in $ORDER; do geom $i; echo "$X $Y $W $H" >> /tmp/wins; done
}
redraw() { NOW=$(date +%H:%M); write_wins; paint do_redraw; }

# ---------------------------------------------------------------
#  window management
# ---------------------------------------------------------------
newwin() {  # type title w h
    local n x y cnt
    set -- "$1" "$2" "$3" "$4"
    cnt=0; for n in $ORDER; do cnt=$((cnt+1)); done
    [ $cnt -ge 8 ] && return 1
    NEWID=$NEXT; NEXT=$((NEXT+1))
    s $NEWID type "$1"; s $NEWID title "$2"; s $NEWID w "$3"; s $NEWID h "$4"
    n=$(( cnt % 6 ))
    x=$((17+n*3)); y=$((3+n*2))
    [ $((x+$3)) -gt $COLS ] && x=$((COLS-$3))
    [ $x -lt 1 ] && x=1
    [ $((y+$4)) -gt $((ROWS-1)) ] && y=$((ROWS-1-$4))
    [ $y -lt 2 ] && y=2
    s $NEWID x $x; s $NEWID y $y; s $NEWID max 0; s $NEWID scroll 0
    ORDER="$ORDER $NEWID"; FOCUS=$NEWID
    return 0
}

close_win() {
    local id=$1 n="" i
    for i in $ORDER; do [ "$i" != "$id" ] && n="$n $i"; done
    ORDER="$n"
    s $id type ""
    FOCUS=""
    for i in $ORDER; do FOCUS=$i; done
}

raise_win() {
    local id=$1 n="" i
    for i in $ORDER; do [ "$i" != "$id" ] && n="$n $i"; done
    ORDER="$n $id"; FOCUS=$id
}

cycle_win() {
    local first
    set -- $ORDER
    [ $# -lt 2 ] && return
    first=$1; shift
    ORDER="$* $first"
    FOCUS=""; for first in $ORDER; do FOCUS=$first; done
}

move_win() {  # dx dy
    local nx ny
    geom $FOCUS
    nx=$((X+$1)); ny=$((Y+$2))
    [ $nx -gt $((COLS-W)) ] && nx=$((COLS-W))
    [ $nx -lt 1 ] && nx=1
    [ $ny -gt $((ROWS-1-H)) ] && ny=$((ROWS-1-H))
    [ $ny -lt 2 ] && ny=2
    s $FOCUS x $nx; s $FOCUS y $ny
}

resize_win() {  # dw dh
    local nw nh
    geom $FOCUS
    nw=$((W+$1)); nh=$((H+$2))
    [ $nw -lt 26 ] && nw=26
    [ $nh -lt 8 ] && nh=8
    [ $((X+nw)) -gt $COLS ] && nw=$((COLS-X))
    [ $((Y+nh)) -gt $((ROWS-1)) ] && nh=$((ROWS-1-Y))
    s $FOCUS w $nw; s $FOCUS h $nh; s $FOCUS max 0
}

toggle_max() {
    local id=$FOCUS m
    [ -z "$id" ] && return
    g $id max m
    if [ "$m" = 1 ]; then
        g $id sx X; g $id sy Y; g $id sw W; g $id sh H
        s $id x $X; s $id y $Y; s $id w $W; s $id h $H; s $id max 0
    else
        geom $id
        s $id sx $X; s $id sy $Y; s $id sw $W; s $id sh $H
        s $id x 1; s $id y 2; s $id w $((COLS-1)); s $id h $((ROWS-3)); s $id max 1
    fi
}

close_popups() {  # [keep-id]  closes Start menu and right-click menus
    local i T closed=""
    for i in $ORDER; do
        g $i type T
        if { [ "$T" = launch ] || [ "$T" = ctx ]; } && [ "$i" != "$1" ]; then
            close_win $i; closed=1
        fi
    done
    [ -n "$closed" ] && ACT=full
}

# ---------------------------------------------------------------
#  NOTEPAD
# ---------------------------------------------------------------
open_note() {  # file
    local b="" sz
    newwin note "Notepad - ${1##*/}" 50 16 || return
    s $NEWID file "$1"; s $NEWID msg ""
    if [ -f "$1" ]; then
        sz=$(wc -c < "$1")
        if [ "$sz" -lt 30000 ]; then b=$(cat "$1"); else s $NEWID msg " [file too big to load]"; fi
    fi
    s $NEWID buf "$b"
}

c_note() {
    local B F M SC
    g $1 buf B; g $1 file F; g $1 msg M; g $1 scroll SC
    emit_text "$B" $((CH-1)) 1 1 ${SC:-0}
    draw_scroll
    crow $((CH-1)) " ^S Save  ^X Close  ${F##*/}${M}" "$STAT"
}

k_note() {
    local id=$1 B F M last
    cgeom $id
    g $id buf B; g $id file F
    M=""
    case "$KEY" in
        "$K_ENTER") B="${B}${NL}" ;;
        "$K_BS"|"$K_BS2") B=${B%?} ;;
        "$K_CS")
            mkdir -p "${F%/*}" 2>/dev/null
            if printf '%s' "$B" > "$F" 2>/dev/null; then M="  [Saved]"; else M="  [Save failed]"; fi ;;
        "$TAB") B="${B}  " ;;
        UP|DOWN|LEFT|RIGHT|ESC|OTHER|DEL) return ;;
        *[[:cntrl:]]*) return ;;
        *) B="${B}${KEY}" ;;
    esac
    last=${B##*"$NL"}
    if [ ${#last} -ge $((CW-3)) ]; then B="${B}${NL}"; fi
    s $id buf "$B"; s $id msg "$M"; s $id scroll 0
}

# ---------------------------------------------------------------
#  FILES
# ---------------------------------------------------------------
files_load() {
    local out
    g $1 dir D
    out=$(ls -Ap "$D" 2>/dev/null)
    if [ -n "$out" ]; then s $1 list "../${NL}${out}"; else s $1 list "../"; fi
    g $1 list L; count_lines "$L"
    s $1 count $CNT; s $1 sel 0; s $1 top 0
}

c_files() {
    local D L SEL TOP
    g $1 dir D; g $1 list L; g $1 sel SEL; g $1 top TOP
    crow 0 " $D" "$STAT"
    emit_list "$L" $SEL $TOP $((CH-2)) 1
    s $1 top $LTOP
    draw_scroll
    crow $((CH-1)) " Enter/dbl-click:Open  Bksp:Up  ^X:Close" "$STAT"
}

k_files() {
    local id=$1 D SEL CNT2 L
    g $id dir D; g $id sel SEL; g $id count CNT2; g $id list L
    case "$KEY" in
        UP)   [ $SEL -gt 0 ] && SEL=$((SEL-1)) ;;
        DOWN) [ $SEL -lt $((CNT2-1)) ] && SEL=$((SEL+1)) ;;
        "$K_BS"|"$K_BS2")
            s $id dir "$(dirname "$D")"; files_load $id; return ;;
        "$K_ENTER")
            nth_line "$L" $SEL
            case "$NTH" in
                "../") s $id dir "$(dirname "$D")"; files_load $id ;;
                */)    s $id dir "${D%/}/${NTH%/}"; files_load $id ;;
                *)     open_note "${D%/}/$NTH"; ACT=full ;;
            esac
            return ;;
    esac
    s $id sel $SEL
}

# ---------------------------------------------------------------
#  TERMINAL (one command at a time; use the full-screen shell for more)
# ---------------------------------------------------------------
c_term() {
    local O D IN SC
    g $1 out O; g $1 dir D; g $1 in IN; g $1 scroll SC
    TXA="$TERMA"
    emit_text "$O" $((CH-1)) 1 0 ${SC:-0}
    draw_scroll
    crow $((CH-1)) "${D}> ${IN}_" "$TERMA"
}

k_term() {
    local id=$1 O D IN cmd arg nd res
    cgeom $id
    g $id out O; g $id dir D; g $id in IN
    case "$KEY" in
        "$K_ENTER")
            cmd=$IN; IN=""
            O="${O}${D}> ${cmd}${NL}"
            case "$cmd" in
                "") ;;
                cd|cd\ *)
                    arg=${cmd#cd}; arg=${arg# }; [ -z "$arg" ] && arg=/root
                    case "$arg" in /*) nd="$arg" ;; *) nd="$D/$arg" ;; esac
                    if [ -d "$nd" ]; then D=$(cd "$nd" && pwd); else O="${O}cd: no such directory${NL}"; fi ;;
                clear) O="" ;;
                exit) close_win $id; ACT=full; return ;;
                *) busy_on
                   res=$( (cd "$D" && eval "$cmd") 2>&1 </dev/null )
                   busy_off
                   O="${O}${res}${NL}" ;;
            esac
            O="$(printf '%s' "$O" | tail -n 200)${NL}" ;;
        "$K_BS"|"$K_BS2") IN=${IN%?} ;;
        UP|DOWN|LEFT|RIGHT|ESC|OTHER|DEL) return ;;
        *[[:cntrl:]]*) return ;;
        *) [ ${#IN} -lt $((CW-${#D}-4)) ] && IN="${IN}${KEY}" ;;
    esac
    s $id out "$O"; s $id dir "$D"; s $id in "$IN"; s $id scroll 0
}

# ---------------------------------------------------------------
#  CALCULATOR   (+ - * x / div mod and parentheses, whole numbers)
# ---------------------------------------------------------------
c_calc() {
    local H2 IN
    g $1 hist H2; g $1 in IN
    emit_text "$H2" $((CH-2)) 1 0 0
    crow $((CH-2)) "" "$BODY"
    crow $((CH-1)) " > ${IN}_" "$STAT"
}

k_calc() {
    local id=$1 H2 IN r E
    cgeom $id
    g $id hist H2; g $id in IN
    case "$KEY" in
        "$K_ENTER")
            E=$(printf '%s' "$IN" | sed 's/div/\//g; s/mod/%/g; s/x/*/g')
            case "$E" in
                "") ;;
                *[!0-9+*/%\(\)" "-]*) H2="${H2} ${IN}${NL}    = invalid characters${NL}" ;;
                *)
                    if r=$( (echo $((E))) 2>/dev/null ); then H2="${H2} ${IN}${NL}    = ${r}${NL}"
                    else H2="${H2} ${IN}${NL}    = error${NL}"; fi ;;
            esac
            IN=""
            H2="$(printf '%s' "$H2" | tail -n 60)${NL}" ;;
        "$K_BS"|"$K_BS2") IN=${IN%?} ;;
        UP|DOWN|LEFT|RIGHT|ESC|OTHER|DEL) return ;;
        *[[:cntrl:]]*) return ;;
        *) [ ${#IN} -lt $((CW-6)) ] && IN="${IN}${KEY}" ;;
    esac
    s $id hist "$H2"; s $id in "$IN"
}

# ---------------------------------------------------------------
#  INFO WINDOWS (System Info / My Computer / About / Help)
# ---------------------------------------------------------------
c_info() {
    local T SC
    g $1 txt T; g $1 scroll SC
    emit_text "$T" $((CH-1)) 0 0 ${SC:-0}
    draw_scroll
    crow $((CH-1)) " R:Refresh  Up/Down/wheel:Scroll  ^X:Close" "$STAT"
}

k_info() {
    local id=$1 B T SC max
    cgeom $id
    g $id txt T; g $id scroll SC
    count_lines "$T"; max=$((CNT-(CH-1)))
    case "$KEY" in
        r|R) busy_on; g $id builder B; $B; busy_off; s $id txt "$TXT" ;;
        UP)   [ ${SC:-0} -gt 0 ] && s $id scroll $((SC-1)) ;;
        DOWN) [ ${SC:-0} -lt $max ] && s $id scroll $((SC+1)) ;;
    esac
}

open_info() {  # builder title w h
    newwin info "$2" $3 $4 || return
    s $NEWID builder "$1"
    busy_on
    $1
    busy_off
    s $NEWID txt "$TXT"
}

hostname_s() { HN=$(hostname 2>/dev/null); case "$HN" in ""|"(none)") HN=claudedos ;; esac; }

sysbits() {
    hostname_s
    UP=$(cut -d. -f1 /proc/uptime 2>/dev/null); UP=${UP:-0}
    MT=$(grep MemTotal /proc/meminfo 2>/dev/null | cut -d: -f2 | tr -d ' kB'); MT=${MT:-0}
    MA=$(grep MemAvailable /proc/meminfo 2>/dev/null | cut -d: -f2 | tr -d ' kB'); MA=${MA:-0}
    CPU=$(grep -m1 'model name' /proc/cpuinfo 2>/dev/null | cut -d: -f2 | sed 's/^ *//'); CPU=${CPU:-unknown}
    CORES=$(grep -c '^processor' /proc/cpuinfo 2>/dev/null)
}

build_sys() {
    sysbits
    TXT=" Host    : ${HN}${NL} Kernel  : $(uname -sr) ($(uname -m))${NL} Uptime  : $((UP/3600))h $(((UP%3600)/60))m $((UP%60))s${NL} CPU     : ${CPU}${NL} Cores   : ${CORES}${NL} Memory  : $(((MT-MA)/1024)) / $((MT/1024)) MiB${NL} Screen  : ${COLS}x${ROWS} text${NL}${NL} Disks:${NL}$(df -h 2>/dev/null | head -5)"
}

build_mycomp() {
    local drives
    sysbits
    drives=$(awk 'NR>2 && $4 ~ /^(sd|vd|hd|nvme|mmcblk|sr)/ { printf " %-14s %8d MB\n", $4, $3/1024 }' /proc/partitions 2>/dev/null)
    [ -z "$drives" ] && drives=" (no drives detected)"
    TXT=" Computer : ${HN}${NL} Processor : ${CPU} (${CORES})${NL} Memory   : $(((MT-MA)/1024)) / $((MT/1024)) MiB${NL} Kernel   : $(uname -sr)${NL} Uptime   : $((UP/3600))h $(((UP%3600)/60))m${NL}${NL} Drives:${NL}${drives}${NL}${NL} Mounted:${NL}$(df -h 2>/dev/null | head -6)"
}

build_about() {
    local L1 L2 L3 L4 L5 L6 L7 L8 L9
    sysbits
    L1='   .--------------.   '
    L2='  /|              |\  '
    L3=' / |  ___________ | \ '
    L4='/  | |...........| |  \'
    L5='|  | |...........| |  |'
    L6='|  | |___________| |  |'
    L7='|__|_______________|__|'
    L8='   |_______________|   '
    L9='    \_____________/    '
    TXT="${NL} ${L1}  root@${HN}${NL} ${L2}  ----------------${NL} ${L3}  OS:      ClaudeDOS Desktop${NL} ${L4}  Kernel:  $(uname -r)${NL} ${L5}  Uptime:  $((UP/3600))h $(((UP%3600)/60))m${NL} ${L6}  Shell:   busybox ash${NL} ${L7}  Init:    custom /init${NL} ${L8}  CPU:     ${CPU}${NL} ${L9}  Memory:  $(((MT-MA)/1024))/$((MT/1024)) MiB (${CORES} cpu)"
}

build_help() {
    TXT=" Welcome to ClaudeDOS Desktop!${NL}${NL} KEYBOARD${NL} Ctrl+N  Start menu     Ctrl+X  close window${NL} Ctrl+S  save (Notepad)${NL} ESC / Ctrl+W  window mode (red bar):${NL}   arrows move, + / - resize, Tab next window,${NL}   M maximize, X close, N Start, D desktop icons${NL}${NL} MOUSE${NL} Click: focus.  Drag title bar: move.${NL} [=] maximize   [x] close   dbl-click title: max${NL} Drag right/bottom edge or corner: resize${NL} Right-click: context menu${NL} Double-click: open icons and files${NL} Wheel: scroll  (^ # v bar on the right edge)${NL}${NL} DESKTOP${NL} My Apps lists every app. My Computer shows${NL} hardware and drives. Settings changes the${NL} theme and timezone (reset on reboot).${NL}${NL} Calculator: + - * x / div mod ( )  e.g. 10div3"
}

# ---------------------------------------------------------------
#  START MENU
# ---------------------------------------------------------------
LAUNCH_ITEMS="1  Notepad${NL}2  Files${NL}3  Terminal${NL}4  Calculator${NL}5  My Apps${NL}6  My Computer${NL}7  Settings${NL}8  Full-screen Shell${NL}9  Shut Down${NL}0  Reboot"
LAUNCH_NAMES="notepad files term calc apps mycomp settings fsshell shutdown reboot"

open_launcher() {
    local i T
    for i in $ORDER; do
        g $i type T
        if [ "$T" = launch ]; then raise_win $i; return; fi
    done
    newwin launch "Start" 30 14 || return
    s $NEWID x 2; s $NEWID y 2; s $NEWID sel 0
}

c_launch() {
    local SEL
    g $1 sel SEL
    crow 0 "" "$BODY"
    emit_list "$LAUNCH_ITEMS" $SEL 0 10 1
    crow $((CH-1)) " Number or Enter. Esc=cancel" "$STAT"
}

k_launch() {
    local id=$1 sel
    g $id sel sel
    case "$KEY" in
        UP)   [ $sel -gt 0 ] && sel=$((sel-1)) ;;
        DOWN) [ $sel -lt 9 ] && sel=$((sel+1)) ;;
        "$K_ENTER") close_win $id; nth_word $sel $LAUNCH_NAMES; launch $NW; ACT=full; return ;;
        [0-9]) close_win $id; nth_word $(( (KEY+9) % 10 )) $LAUNCH_NAMES; launch $NW; ACT=full; return ;;
    esac
    s $id sel $sel
}

# ---------------------------------------------------------------
#  MY APPS
# ---------------------------------------------------------------
APPS_LIST="Notepad${NL}Files${NL}Terminal${NL}Calculator${NL}System Info${NL}About ClaudeDOS${NL}Help${NL}Settings${NL}My Computer${NL}Full-screen Shell"
APPS_NAMES="notepad files term calc sys about help settings mycomp fsshell"

open_apps() {
    newwin apps "My Apps" 40 16 || return
    s $NEWID sel 0; s $NEWID top 0; s $NEWID count 10
}

c_apps() {
    local SEL TOP
    g $1 sel SEL; g $1 top TOP
    crow 0 " Double-click or Enter to open" "$STAT"
    emit_list "$APPS_LIST" $SEL $TOP $((CH-2)) 1
    s $1 top $LTOP
    draw_scroll
    crow $((CH-1)) " Up/Down  Enter:Open  ^X:Close" "$STAT"
}

apps_open() {  # id
    local SEL
    g $1 sel SEL
    nth_word $SEL $APPS_NAMES
    launch $NW
    ACT=full
}

k_apps() {
    local id=$1 SEL
    g $id sel SEL
    case "$KEY" in
        UP)   [ $SEL -gt 0 ] && SEL=$((SEL-1)) ;;
        DOWN) [ $SEL -lt 9 ] && SEL=$((SEL+1)) ;;
        "$K_ENTER") apps_open $id; return ;;
    esac
    s $id sel $SEL
}

# ---------------------------------------------------------------
#  SETTINGS
# ---------------------------------------------------------------
open_settings() {
    newwin settings "Settings" 50 13 || return
    s $NEWID sel 0
}

c_settings() {
    local SEL r items
    g $1 sel SEL
    crow 0 " Click a row or press Enter to change it" "$STAT"
    items="Theme:     ${THEME_LABEL}${NL}Timezone:  ${TZ_LABEL}"
    emit_list "$items" $SEL 0 2 1
    r=3
    while [ $r -lt $((CH-1)) ]; do crow $r "" "$BODY"; r=$((r+1)); done
    crow 4 " Left/Right: previous / next choice" "$BODY"
    crow 6 " Settings live in RAM and reset on reboot." "$BODY"
    crow $((CH-1)) " Up/Down  Enter  ^X:Close" "$STAT"
}

settings_change() {  # row delta
    if [ $1 -eq 0 ]; then
        THEME_IDX=$(( (THEME_IDX + $2 + 4) % 4 ))
        nth_word $THEME_IDX $THEME_NAMES
        apply_theme $NW
    else
        TZ_IDX=$(( (TZ_IDX + $2 + TZ_COUNT) % TZ_COUNT ))
        set_tz $TZ_IDX
    fi
    ACT=full
}

k_settings() {
    local id=$1 SEL
    g $id sel SEL
    case "$KEY" in
        UP)   SEL=0 ;;
        DOWN) SEL=1 ;;
        "$K_ENTER"|RIGHT|" ") settings_change $SEL 1 ;;
        LEFT) settings_change $SEL -1 ;;
    esac
    s $id sel $SEL
}

# ---------------------------------------------------------------
#  RIGHT-CLICK MENU
# ---------------------------------------------------------------
open_ctx() {  # col row target
    local c=$1 r=$2 tgt=$3 items names nit nx ny
    if [ -n "$tgt" ]; then
        items="Close window${NL}Maximize / Restore${NL}New Notepad${NL}Settings"
        names="close${NL}max${NL}notepad${NL}settings"; nit=4
    else
        items="My Apps${NL}My Computer${NL}New Notepad${NL}Terminal${NL}Settings"
        names="apps${NL}mycomp${NL}notepad${NL}term${NL}settings"; nit=5
    fi
    newwin ctx "Menu" 24 $((nit+2)) || return
    s $NEWID items "$items"; s $NEWID names "$names"; s $NEWID tgt "$tgt"
    s $NEWID sel 0; s $NEWID count $nit
    nx=$c; ny=$r
    [ $((nx+24)) -gt $COLS ] && nx=$((COLS-24))
    [ $((ny+nit+2)) -gt $((ROWS-1)) ] && ny=$((ROWS-1-nit-2))
    [ $nx -lt 1 ] && nx=1
    [ $ny -lt 2 ] && ny=2
    s $NEWID x $nx; s $NEWID y $ny
}

c_ctx() {
    local SEL L
    g $1 sel SEL; g $1 items L
    emit_list "$L" $SEL 0 $CH 0
}

ctx_do() {  # id index
    local id=$1 tgt act T NM
    g $id tgt tgt
    g $id names NM
    nth_line "$NM" $2
    act=$NTH
    close_win $id
    ACT=full
    case "$act" in
        close)    g "${tgt:-0}" type T; [ -n "$T" ] && close_win $tgt ;;
        max)      g "${tgt:-0}" type T; [ -n "$T" ] && { raise_win $tgt; toggle_max; } ;;
        *)        launch $act ;;
    esac
}

k_ctx() {
    local id=$1 sel cnt
    g $id sel sel; g $id count cnt
    case "$KEY" in
        UP)   [ $sel -gt 0 ] && sel=$((sel-1)) ;;
        DOWN) [ $sel -lt $((cnt-1)) ] && sel=$((sel+1)) ;;
        "$K_ENTER") ctx_do $id $sel; return ;;
    esac
    s $id sel $sel
}

# ---------------------------------------------------------------
#  launching things
# ---------------------------------------------------------------
launch() {
    case "$1" in
        notepad)  open_note /root/scratch.txt ;;
        files)    newwin files "Files" 46 16 && { s $NEWID dir /root; files_load $NEWID; } ;;
        term)     newwin term "Terminal" 62 16 && { s $NEWID dir /root; s $NEWID out "ClaudeDOS terminal. One command at a time.${NL}Try: ls, cat, ps, free, df, dmesg${NL}"; s $NEWID in ""; } ;;
        calc)     newwin calc "Calculator" 40 14 && { s $NEWID hist " Try: 12*(3+4)   10div3   7mod3${NL} Operators: + - * x / div mod ( )${NL} (whole numbers only)${NL}"; s $NEWID in ""; } ;;
        sys)      open_info build_sys "System Info" 58 16 ;;
        about)    open_info build_about "About ClaudeDOS" 62 15 ;;
        help)     open_info build_help "Help" 56 22 ;;
        mycomp)   open_info build_mycomp "My Computer" 62 18 ;;
        apps)     open_apps ;;
        settings) open_settings ;;
        fsshell)  fs_shell ;;
        shutdown) shutdown_now ;;
        reboot)   reboot_now ;;
    esac
}

fs_shell() {
    local pid
    pid=$(cat /tmp/kbm.pid 2>/dev/null)
    [ -n "$pid" ] && kill -USR1 $pid 2>/dev/null
    sleep 0.3 2>/dev/null || sleep 1
    stty -F /dev/tty sane
    printf '%s[?25h%s[0m%s[2J%s[H%s[?7h' "$ESC" "$ESC" "$ESC" "$ESC" "$ESC"
    printf 'ClaudeDOS full-screen shell. Type "exit" to return to the desktop.\n\n'
    HOME=/root sh </dev/tty
    [ -n "$pid" ] && kill -CONT $pid 2>/dev/null
    printf '%s[?25l%s[?7l' "$ESC" "$ESC"
}

shutdown_now() {
    printf '%s[0m%s[2J%s[H%s[?25h%s[?7hShutting down ClaudeDOS...\n' "$ESC" "$ESC" "$ESC" "$ESC" "$ESC"
    sync; sleep 1; poweroff -f
}
reboot_now() {
    printf '%s[0m%s[2J%s[H%s[?25h%s[?7hRebooting...\n' "$ESC" "$ESC" "$ESC" "$ESC" "$ESC"
    sync; sleep 1; reboot -f
}

# ---------------------------------------------------------------
#  input
# ---------------------------------------------------------------
read_key() {
    IFS= read -r LINE || exit 0
    EVT=${LINE%"${LINE#?}"}
    VAL=${LINE#?}
    KEY=""
    case "$EVT" in
        p) KEY="$VAL" ;;
        c) case "$VAL" in
               13) KEY="$K_ENTER" ;;
               127) KEY="$K_BS" ;;
               8) KEY="$K_BS2" ;;
               9) KEY="$TAB" ;;
               19) KEY="$K_CS" ;;
               24) KEY="$K_CX" ;;
               23) KEY="$K_CW" ;;
               14) KEY="$K_CN" ;;
               *) KEY=OTHER ;;
           esac ;;
        n) KEY="$VAL" ;;
        d|u|g|x|r|w) KEY=MOUSE; MT="$EVT"; set -- $VAL; MC=$1; MR=$2; MD=$3 ;;
    esac
}

wm_key() {
    case "$KEY" in
        UP)    [ -n "$FOCUS" ] && { move_win 0 -1; ACT=full; } ;;
        DOWN)  [ -n "$FOCUS" ] && { move_win 0 1; ACT=full; } ;;
        LEFT)  [ -n "$FOCUS" ] && { move_win -2 0; ACT=full; } ;;
        RIGHT) [ -n "$FOCUS" ] && { move_win 2 0; ACT=full; } ;;
        "+"|"=") [ -n "$FOCUS" ] && { resize_win 4 2; ACT=full; } ;;
        "-"|"_") [ -n "$FOCUS" ] && { resize_win -4 -2; ACT=full; } ;;
        "$TAB")  cycle_win; ACT=full ;;
        m|M)   [ -n "$FOCUS" ] && { toggle_max; ACT=full; } ;;
        x|X)   [ -n "$FOCUS" ] && { close_win $FOCUS; ACT=full; } ;;
        n|N)   open_launcher; MODE=app; ACT=full ;;
        d|D)   MODE=icons; ICON_SEL=0; ACT=full ;;
        ESC|"$K_ENTER"|" ") MODE=app; ACT=top ;;
    esac
}

open_icon() {  # index
    case "$1" in
        0) launch apps ;;
        1) launch mycomp ;;
        2) launch files ;;
    esac
}

icons_key() {
    case "$KEY" in
        UP)    [ $ICON_SEL -gt 0 ] && ICON_SEL=$((ICON_SEL-1)); ACT=full ;;
        DOWN)  [ $ICON_SEL -lt 2 ] && ICON_SEL=$((ICON_SEL+1)); ACT=full ;;
        "$K_ENTER") open_icon $ICON_SEL; MODE=app; ICON_SEL=-1; ACT=full ;;
        ESC|d|D) MODE=app; ICON_SEL=-1; ACT=full ;;
    esac
}

app_key() {
    local T
    g $FOCUS type T
    case "$T" in
        note)     k_note $FOCUS ;;
        files)    k_files $FOCUS ;;
        term)     k_term $FOCUS ;;
        calc)     k_calc $FOCUS ;;
        info)     k_info $FOCUS ;;
        launch)   k_launch $FOCUS ;;
        apps)     k_apps $FOCUS ;;
        settings) k_settings $FOCUS ;;
        ctx)      k_ctx $FOCUS ;;
    esac
    [ -z "$ACT" ] && ACT=content
}

tick() {
    local n
    n=$(date +%H:%M)
    if [ "$n" != "$NOW" ]; then NOW=$n; paint draw_clock; fi
}

# ---------------------------------------------------------------
#  MOUSE
# ---------------------------------------------------------------
DRAGID=""; DRAGMODE=""; DRAGDX=0

win_at() {  # col row -> WHIT = topmost window under that cell
    local rev="" i
    for i in $ORDER; do rev="$i $rev"; done
    WHIT=""
    for i in $rev; do
        geom $i
        if [ $1 -ge $X ] && [ $1 -lt $((X+W)) ] && [ $2 -ge $Y ] && [ $2 -lt $((Y+H)) ]; then
            WHIT=$i; return
        fi
    done
}

icon_at() {  # col row -> ICONHIT = icon index, or empty
    local idx
    ICONHIT=""
    if [ $2 -ge 3 ] && [ $(( ($2-3) % 2 )) -eq 0 ] && [ $1 -ge 3 ] && [ $1 -le 15 ]; then
        idx=$(( ($2-3)/2 ))
        [ $idx -lt 3 ] && ICONHIT=$idx
    fi
}

m_launch() {  # id col row
    local rr=$(($3-CY))
    if [ $rr -ge 1 ] && [ $rr -le 10 ]; then
        close_win $1; nth_word $((rr-1)) $LAUNCH_NAMES; launch $NW; ACT=full
    fi
}

m_list_select() {  # id col row  -> selects the clicked row of a files/apps list
    local rr=$(($3-CY)) SEL TOP CNT2 idx
    g $1 sel SEL; g $1 top TOP; g $1 count CNT2
    idx=$((rr-1+TOP))
    LISTHIT=""
    if [ $rr -ge 1 ] && [ $rr -le $((CH-2)) ] && [ $idx -lt $CNT2 ]; then
        s $1 sel $idx; LISTHIT=$idx; ACT=content
    fi
}

m_ctx() {  # id col row
    local rr=$(($3-CY)) cnt
    g $1 count cnt
    if [ $rr -ge 0 ] && [ $rr -lt $cnt ]; then ctx_do $1 $rr; fi
}

m_settings() {  # id col row
    local rr=$(($3-CY))
    if [ $rr -ge 1 ] && [ $rr -le 2 ]; then
        s $1 sel $((rr-1)); settings_change $((rr-1)) 1
    fi
}

mouse_down() {  # col row
    local c=$1 r=$2 i T st en m
    DRAGID=""
    if [ $r -eq $ROWS ]; then
        close_popups 0
        if [ $c -le 10 ]; then open_launcher; MODE=app; ACT=full; return; fi
        i=1
        while [ $i -lt $NEXT ]; do
            g $i type T
            if [ -n "$T" ]; then
                g $i tbs st; g $i tbe en
                if [ $c -ge $st ] && [ $c -le $en ]; then raise_win $i; MODE=app; ACT=full; return; fi
            fi
            i=$((i+1))
        done
        return
    fi
    win_at $c $r
    if [ -z "$WHIT" ]; then
        close_popups 0
        icon_at $c $r
        if [ -n "$ICONHIT" ]; then ICON_SEL=$ICONHIT; ACT=full
        elif [ $ICON_SEL -ge 0 ]; then ICON_SEL=-1; ACT=full; fi
        return
    fi
    i=$WHIT
    g $i type T
    if [ "$T" != launch ] && [ "$T" != ctx ]; then close_popups 0; fi
    if [ $ICON_SEL -ge 0 ]; then ICON_SEL=-1; ACT=full; fi
    if [ "$i" != "$FOCUS" ]; then raise_win $i; ACT=full; fi
    if [ "$MODE" != app ]; then MODE=app; ACT=full; fi
    geom $i
    if [ $r -eq $Y ]; then
        if [ $c -ge $((X+W-3)) ]; then
            close_win $i; ACT=full
        elif [ $c -ge $((X+W-6)) ]; then
            toggle_max; ACT=full
        else
            g $i max m
            if [ "$m" != 1 ]; then DRAGID=$i; DRAGMODE=move; DRAGDX=$((c-X)); fi
        fi
    elif [ $r -eq $((Y+H-1)) ] && [ $c -eq $((X+W-1)) ]; then
        DRAGID=$i; DRAGMODE=both
    elif [ $c -eq $((X+W-1)) ]; then
        DRAGID=$i; DRAGMODE=width
    elif [ $r -eq $((Y+H-1)) ]; then
        DRAGID=$i; DRAGMODE=height
    else
        cgeom $i
        case "$T" in
            launch)   m_launch $i $c $r ;;
            ctx)      m_ctx $i $c $r ;;
            files|apps) m_list_select $i $c $r ;;
            settings) m_settings $i $c $r ;;
        esac
    fi
}

mouse_drag() {  # col row
    local id=$DRAGID T nx ny nw nh
    [ -z "$id" ] && return
    g $id type T
    if [ -z "$T" ]; then DRAGID=""; return; fi
    geom $id
    if [ "$DRAGMODE" = move ]; then
        nx=$(($1-DRAGDX)); ny=$2
        [ $nx -gt $((COLS-W)) ] && nx=$((COLS-W))
        [ $nx -lt 1 ] && nx=1
        [ $ny -gt $((ROWS-1-H)) ] && ny=$((ROWS-1-H))
        [ $ny -lt 2 ] && ny=2
        s $id x $nx; s $id y $ny
    else
        nw=$W; nh=$H
        case "$DRAGMODE" in width|both) nw=$(($1-X+1)) ;; esac
        case "$DRAGMODE" in height|both) nh=$(($2-Y+1)) ;; esac
        [ $nw -lt 26 ] && nw=26
        [ $nh -lt 8 ] && nh=8
        [ $((X+nw)) -gt $COLS ] && nw=$((COLS-X))
        [ $((Y+nh)) -gt $((ROWS-1)) ] && nh=$((ROWS-1-Y))
        s $id w $nw; s $id h $nh; s $id max 0
    fi
    ACT=full
}

mouse_dbl() {  # col row  (sent right after the matching press)
    local c=$1 r=$2 i T
    DRAGID=""
    win_at $c $r
    if [ -z "$WHIT" ]; then
        icon_at $c $r
        if [ -n "$ICONHIT" ]; then open_icon $ICONHIT; ICON_SEL=-1; ACT=full; fi
        return
    fi
    i=$WHIT
    g $i type T
    geom $i; cgeom $i
    if [ $r -eq $Y ]; then
        if [ $c -lt $((X+W-6)) ]; then toggle_max; ACT=full; fi
        return
    fi
    case "$T" in
        files) m_list_select $i $c $r
               if [ -n "$LISTHIT" ]; then KEY="$K_ENTER"; k_files $i; ACT=full; fi ;;
        apps)  m_list_select $i $c $r
               if [ -n "$LISTHIT" ]; then apps_open $i; fi ;;
    esac
}

mouse_rclick() {  # col row
    local c=$1 r=$2 tgt=""
    DRAGID=""
    close_popups 0
    ACT=full
    [ $r -eq $ROWS ] && return
    [ $r -eq 1 ] && return
    win_at $c $r
    tgt=$WHIT
    [ -n "$tgt" ] && raise_win $tgt
    open_ctx $c $r "$tgt"
}

mouse_wheel() {  # col row dir(+1 down, -1 up)
    local id T CNT2 TOP SEL max nt SC txt
    win_at $1 $2
    id=$WHIT
    [ -z "$id" ] && return
    g $id type T
    cgeom $id
    case "$T" in
        files|apps)
            g $id count CNT2; g $id top TOP; g $id sel SEL
            max=$((CH-2))
            nt=$((TOP+$3*3))
            [ $nt -gt $((CNT2-max)) ] && nt=$((CNT2-max))
            [ $nt -lt 0 ] && nt=0
            s $id top $nt
            [ $SEL -lt $nt ] && s $id sel $nt
            [ $SEL -ge $((nt+max)) ] && s $id sel $((nt+max-1))
            ;;
        term|note)
            if [ "$T" = term ]; then g $id out txt; else g $id buf txt; fi
            count_lines "$txt"; max=$((CNT-(CH-1)))
            g $id scroll SC; SC=${SC:-0}
            nt=$((SC-$3*3))
            [ $nt -gt $max ] && nt=$max
            [ $nt -lt 0 ] && nt=0
            s $id scroll $nt
            ;;
        info)
            g $id txt txt
            count_lines "$txt"; max=$((CNT-(CH-1)))
            g $id scroll SC; SC=${SC:-0}
            nt=$((SC+$3*3))
            [ $nt -gt $max ] && nt=$max
            [ $nt -lt 0 ] && nt=0
            s $id scroll $nt
            ;;
        *) return ;;
    esac
    ACT=full
}

# ---------------------------------------------------------------
#  main
# ---------------------------------------------------------------
mkdir -p /root /tmp
rm -f /tmp/busy
printf '%s[?7l' "$ESC"

open_info build_help "Welcome" 56 22
redraw

while :; do
    read_key
    if [ -z "$KEY" ]; then tick; continue; fi
    ACT=""
    if [ "$KEY" = MOUSE ]; then
        case "$MT" in
            d) mouse_down $MC $MR ;;
            g) mouse_drag $MC $MR ;;
            u) DRAGID="" ;;
            x) mouse_dbl $MC $MR ;;
            r) mouse_rclick $MC $MR ;;
            w) mouse_wheel $MC $MR $MD ;;
        esac
    elif [ "$KEY" = "$K_CN" ]; then
        open_launcher; MODE=app; ACT=full
    elif [ "$KEY" = "$K_CW" ]; then
        if [ "$MODE" = app ]; then MODE=wm; else MODE=app; ICON_SEL=-1; fi
        ACT=full
    elif [ "$MODE" = wm ]; then
        wm_key
    elif [ "$MODE" = icons ]; then
        icons_key
    elif [ "$KEY" = "$K_CX" ]; then
        [ -n "$FOCUS" ] && { close_win $FOCUS; ACT=full; }
    elif [ "$KEY" = ESC ]; then
        g "${FOCUS:-0}" type T
        if [ "$T" = launch ] || [ "$T" = ctx ]; then close_win $FOCUS; ACT=full; else MODE=wm; ACT=top; fi
    elif [ -n "$FOCUS" ]; then
        app_key
    fi
    case "$ACT" in
        full)    redraw ;;
        content) [ -n "$FOCUS" ] && paint draw_content $FOCUS ;;
        top)     paint draw_topbar ;;
    esac
done
