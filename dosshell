launch() {
    case "$1" in
        notepad)  open_note /root/scratch.txt ;;
        files)    newwin files "Files" 46 16 && { s $NEWID dir /root; files_load $NEWID; } ;;
        term)     newwin term "Terminal" 62 16 && { s $NEWID dir /root; s $NEWID out "ClaudeDOS terminal. One command at a time.${NL}Try: ls, cat, ps, free, df, dmesg${NL}"; s $NEWID in ""; } ;;
        calc)     newwin calc "Calculator" 40 14 && { s $NEWID hist " Try: 12*(3+4)   10div3   7mod3${NL} Operators: + - * x / div mod ( )${NL} (whole numbers only)${NL}"; s $NEWID in ""; } ;;
        sys)      open_info build_sys "System Info" 58 16 ;;
        about)    open_info build_about "About ClaudeDOS" 62 15 ;;
        help)     open_info build_help "Help" 56 22 ;;
        mycomp)   open_info build_mycomp "My Computer" 62 18 ;;
        apps)     open_apps ;;
        settings) open_settings ;;
        pong)     open_pong ;;
        ttt)      open_ttt ;;
        fsshell)  fs_shell ;;
        shutdown) shutdown_now ;;
        reboot)   reboot_now ;;
    esac
}

fs_shell() {
    local pid
    pid=$(cat /tmp/kbm.pid 2>/dev/null)
    [ -n "$pid" ] && kill -USR1 $pid 2>/dev/null
    sleep 0.3 2>/dev/null || sleep 1
    stty -F /dev/tty sane
    printf '%s[?25h%s[0m%s[2J%s[H%s[?7h' "$ESC" "$ESC" "$ESC" "$ESC" "$ESC"
    printf 'ClaudeDOS full-screen shell. Type "exit" to return to the desktop.\n\n'
    HOME=/root sh </dev/tty
    [ -n "$pid" ] && kill -CONT $pid 2>/dev/null
    printf '%s[?25l%s[?7l' "$ESC" "$ESC"
}

shutdown_now() {
    printf '%s[0m%s[2J%s[H%s[?25h%s[?7hShutting down ClaudeDOS...\n' "$ESC" "$ESC" "$ESC" "$ESC" "$ESC"
    sync; sleep 1; poweroff -f
}
reboot_now() {
    printf '%s[0m%s[2J%s[H%s[?25h%s[?7hRebooting...\n' "$ESC" "$ESC" "$ESC" "$ESC" "$ESC"
    sync; sleep 1; reboot -f
}

