read_key() {
    IFS= read -r LINE || exit 0
    EVT=${LINE%"${LINE#?}"}
    VAL=${LINE#?}
    KEY=""
    case "$EVT" in
        p) KEY="$VAL" ;;
        c) case "$VAL" in
               13) KEY="$K_ENTER" ;;
               127) KEY="$K_BS" ;;
               8) KEY="$K_BS2" ;;
               9) KEY="$TAB" ;;
               19) KEY="$K_CS" ;;
               24) KEY="$K_CX" ;;
               23) KEY="$K_CW" ;;
               14) KEY="$K_CN" ;;
               *) KEY=OTHER ;;
           esac ;;
        n) KEY="$VAL" ;;
        f) KEY=FAST; set -- $VAL; MC=${1:-0}; MR=${2:-0} ;;
        d|u|g|x|r|w) KEY=MOUSE; MT="$EVT"; set -- $VAL; MC=$1; MR=$2; MD=$3 ;;
    esac
}

wm_key() {
    case "$KEY" in
        UP)    [ -n "$FOCUS" ] && { move_win 0 -1; ACT=full; } ;;
        DOWN)  [ -n "$FOCUS" ] && { move_win 0 1; ACT=full; } ;;
        LEFT)  [ -n "$FOCUS" ] && { move_win -2 0; ACT=full; } ;;
        RIGHT) [ -n "$FOCUS" ] && { move_win 2 0; ACT=full; } ;;
        "+"|"=") [ -n "$FOCUS" ] && { resize_win 4 2; ACT=full; } ;;
        "-"|"_") [ -n "$FOCUS" ] && { resize_win -4 -2; ACT=full; } ;;
        "$TAB")  cycle_win; ACT=full ;;
        m|M)   [ -n "$FOCUS" ] && { toggle_max; ACT=full; } ;;
