#!/bin/busybox sh
# This is PID 1 - boots straight into the retro DOS Shell menu

/bin/busybox mount -t proc none /proc
/bin/busybox mount -t sysfs none /sys
/bin/busybox mount -t devtmpfs none /dev 2>/dev/null || /bin/busybox mount -t tmpfs none /dev

# Load keyboard drivers (USB HID) - host controllers are built into the kernel.
# hid.ko = core HID protocol, usbhid.ko = USB transport, hid-generic.ko = the
# actual driver that binds a HID device to usable keyboard input
/bin/busybox insmod /lib/modules/hid.ko 2>/dev/null
/bin/busybox insmod /lib/modules/usbhid.ko 2>/dev/null
/bin/busybox insmod /lib/modules/hid-generic.ko 2>/dev/null
/bin/busybox insmod /lib/modules/libahci.ko 2>/dev/null
/bin/busybox insmod /lib/modules/ahci.ko 2>/dev/null
/bin/busybox insmod /lib/modules/usb-storage.ko 2>/dev/null
/bin/busybox insmod /lib/modules/nvme-auth.ko 2>/dev/null
/bin/busybox insmod /lib/modules/nvme-core.ko 2>/dev/null
/bin/busybox insmod /lib/modules/nvme.ko 2>/dev/null
# PS/2 mouse / trackpoint / touchpad (USB mice use usbhid above; mousedev is built in)
/bin/busybox insmod /lib/modules/psmouse.ko 2>/dev/null
[ -e /dev/input/mice ] || { /bin/busybox mkdir -p /dev/input; /bin/busybox mknod /dev/input/mice c 13 63 2>/dev/null; }
[ -e /dev/vcsa ] || /bin/busybox mknod /dev/vcsa c 7 128 2>/dev/null
/bin/busybox sleep 1

# keep late kernel messages from scribbling over the desktop
echo '1 1 1 1' > /proc/sys/kernel/printk 2>/dev/null

/bin/busybox clear

# ANSI art boot banner
printf "\033[1;36m"
cat << 'BANNER'

  ____ _        _   _   _ ____  _____ ____   ___  ____
 / ___| |      / \ | | | |  _ \| ____|  _ \ / _ \/ ___|
| |   | |     / _ \| | | | | | |  _| | | | | | | \___ \
| |___| |___ / ___ \ |_| | |_| | |___| |_| | |_| |___) |
 \____|_____/_/   \_\___/|____/|_____|____/ \___/|____/

                    D E S K T O P

BANNER
printf "\033[0m"
printf "\n  Kernel: %s\n" "$(uname -r)"
printf "  Starting the desktop...\n\n"
/bin/busybox sleep 2

exec /bin/busybox setsid /bin/busybox cttyhack /bin/desktop
